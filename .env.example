# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Base de datos: Supabase ---
# Supabase → tu proyecto → botón "Connect" → "Session pooler" (puerto 5432).
# Usa el Session pooler: la conexión directa (db.<ref>.supabase.co) es solo IPv6
# y suele fallar desde Docker/Railway. Reemplaza [YOUR-PASSWORD] por la contraseña
# de la base (si tiene caracteres especiales como @ # / %, codifícalos en la URL).
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:[YOUR-PASSWORD]@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# SSL: se activa solo al detectar un host de Supabase.
# Para verificar el certificado (recomendado en producción), descarga el CA en
# Supabase → Project Settings → Database → SSL Configuration y pega su contenido
# en una sola línea con \n como separador de líneas:
# DB_SSL=verify
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
DB_POOL_MAX=10

# --- PostgreSQL local (solo con docker-compose.local-db.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=turnos

# --- Backend ---
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro
# Sesión del panel: token de acceso corto + renovación automática
JWT_EXPIRES_IN=15m
# La sesión vence si no se usa en estas horas, y dura como máximo estos días desde el login
REFRESH_IDLE_HOURS=12
SESSION_MAX_DAYS=7
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_password_admin
PORT=5000
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
REACT_APP_API_URL=http://localhost:5000
